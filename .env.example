# Environment variable NAMES with placeholder values. Never commit real values.
NODE_ENV=production
PORT=3000

# MySQL / MariaDB (Hostinger hPanel -> Databases)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Persistent media directory: ONE location for every upload
# (profile images, project media, galleries, paper media).
# Must be OUTSIDE hbuilds/ and public_html/, e.g.
#   /home/<user>/domains/<domain>/media_uploads
MEDIA_STORAGE_DIR=/home/your_user/domains/your-domain.tld/media_uploads
# UPLOAD_DIR is a deprecated alias of MEDIA_STORAGE_DIR; do not set both.

# NOTE: there is no PUBLIC_MEDIA_URL. Every media URL is /media/<path>, served from
# MEDIA_STORAGE_DIR by the app itself. Delete PUBLIC_MEDIA_URL / UPLOAD_DIR from Hostinger.

SITE_URL=https://your-domain.tld
ADMIN_ORIGIN=
SESSION_COOKIE_DOMAIN=

# On-demand revalidation secret
REVALIDATE_SECRET=change-me

# Production uses MySQL only. The embedded SQLite engine is disabled in production
# unless you explicitly set this (not recommended):
# ALLOW_SQLITE_FALLBACK=true
