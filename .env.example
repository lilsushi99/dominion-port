# Environment Variables (.env.example - names and references)

NODE_ENV=production
PORT=3000

# Database Configuration (MySQL / MariaDB on Hostinger)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u475835399_portuser
DB_PASSWORD=ProductDesigner@2024
DB_NAME=u475835399_portdb

# Persistent Media Storage (CRITICAL FOR HOSTINGER)
# Set to an absolute path OUTSIDE hbuilds and public_html, e.g.:
# /home/u123456789/domains/yourdomain.com/media_uploads
# or /home/u123456789/media_uploads
MEDIA_STORAGE_DIR=/home/u475835399/domains/brandoai.online/media_uploads/
UPLOAD_DIR=/home/u475835399/domains/brandoai.online/media_uploads/

# Public Media URL Prefix (Used by browser to stream assets)
PUBLIC_MEDIA_URL=/media

# Public Domain URLs
SITE_URL=https://brandoai.online/
ADMIN_ORIGIN=https://yourdomain.com
SESSION_COOKIE_DOMAIN=

# Security & On-Demand ISR Revalidation
REVALIDATE_SECRET=
NEXT_PUBLIC_API_URL=
API_URL=
